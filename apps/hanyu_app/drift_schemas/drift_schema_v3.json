  "fixed_sql": [
    {
      "name": "local_words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_words\" (\"id\" TEXT NOT NULL, \"hanzi\" TEXT NOT NULL, \"pinyin\" TEXT NOT NULL, \"meaning\" TEXT NOT NULL, \"example_hanzi\" TEXT NOT NULL DEFAULT '', \"example_vietnamese\" TEXT NOT NULL DEFAULT '', \"personal\" INTEGER NOT NULL CHECK (\"personal\" IN (0, 1)), \"saved\" INTEGER NOT NULL DEFAULT 0 CHECK (\"saved\" IN (0, 1)), \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_metadata\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "local_receipts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_receipts\" (\"operation_id\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL, PRIMARY KEY (\"operation_id\"));"
        }
      ]
    },
    {
      "name": "local_schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_schedules\" (\"word_id\" TEXT NOT NULL REFERENCES local_words (id) ON DELETE CASCADE, \"repetitions\" INTEGER NOT NULL DEFAULT 0, \"interval_days\" INTEGER NOT NULL DEFAULT 0, \"ease\" REAL NOT NULL DEFAULT 2.5, \"due_at\" INTEGER NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), PRIMARY KEY (\"word_id\"));"
        }
      ]
    },
    {
      "name": "local_review_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_review_sessions\" (\"id\" TEXT NOT NULL, \"cards_json\" TEXT NOT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, \"revealed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"revealed\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_review_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_review_events\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES local_review_sessions (id) ON DELETE CASCADE, \"word_id\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"quality\" INTEGER NOT NULL, \"accepted_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_exam_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_exam_attempts\" (\"id\" TEXT NOT NULL, \"package_id\" TEXT NOT NULL, \"package_version\" TEXT NOT NULL, \"target_level\" INTEGER NOT NULL, \"mode\" TEXT NOT NULL, \"questions_json\" TEXT NOT NULL, \"answers_json\" TEXT NOT NULL DEFAULT '{}', \"position\" INTEGER NOT NULL DEFAULT 0, \"started_at\" INTEGER NOT NULL, \"deadline\" INTEGER NOT NULL, \"submitted_at\" INTEGER NULL, \"timed_out\" INTEGER NOT NULL DEFAULT 0 CHECK (\"timed_out\" IN (0, 1)), \"correct_count\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
